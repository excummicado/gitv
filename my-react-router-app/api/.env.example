# Copy to .env and fill in. Never commit .env.

# Generate with: openssl rand -hex 32
SECRET_KEY=""

# SQLite is only for the time being.
DATABASE_URL="sqlite:///gitv.db"
# Players: 30 days. Admins: 60 minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Discord Developer Portal > your app > OAuth2
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Must match a redirect registered in the Discord Developer Portal exactly.
DISCORD_REDIRECT_URI="http://localhost:5173/api/v1/auth/discord/callback"
FRONTEND_URL="http://localhost:5173"
