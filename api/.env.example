# Copy to .env and fill in. Never commit .env.

# Generate with: openssl rand -hex 32
SECRET_KEY=""

# SQLite is only for the time being.
DATABASE_URL="sqlite:///gitv.db"
# Players: 30 days. Admins: 60 minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Discord Developer Portal > your app > OAuth2
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Must match a redirect registered in the Discord Developer Portal exactly.
DISCORD_REDIRECT_URI="http://localhost:5173/api/v1/auth/discord/callback"
FRONTEND_URL="http://localhost:5173"

# Background sync with the tournament site (imports new finished tournaments), in seconds.
# 0 = off. Never more often than once an hour: lower values become 3600. Run a single API worker then.
SYNC_INTERVAL=0

# Behind a reverse proxy that sets X-Forwarded-For: rate limits tell clients apart by it.
TRUST_FORWARDED_FOR=false

# The stream (services/stream.py): its Telegram channel (read from t.me/s/, no keys) and Twitch channel.
STREAM_TELEGRAM_CHANNEL="abysscup"
TWITCH_CHANNEL="abyss__cup"
# House of the Hearth's stream, the same way
HOTH_TELEGRAM_CHANNEL="hoth_abyss"
HOTH_TWITCH_CHANNEL="abyss_hoth"
# dev.twitch.tv > Applications: for the stream's live status. Empty: the channel's posts alone tell what's on.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# HotH Hub integration key (hoth-hub.site): House of the Hearth match timers; leave empty to skip
HOTH_HUB_KEY=
